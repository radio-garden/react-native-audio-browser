# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# AudioBrowser requires iOS 16.0; track RN's floor but never go below 16.0
platform :ios, [min_ios_version_supported.to_f, 16.0].max.to_s
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'AudioBrowserExample' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        # Strict concurrency for AudioBrowser. NOTE: deliberately do NOT pin
        # SWIFT_VERSION here -- the podspec declares swift_version 6.2 and
        # consumers get that, so overriding it to 6.0 would make the example
        # build laxer than real consumers and mask data-race diagnostics.
        if target.name == 'AudioBrowser'
          config.build_settings['SWIFT_STRICT_CONCURRENCY'] = 'complete'
        end

        # Disable BUILD_LIBRARY_FOR_DISTRIBUTION for Kingfisher to fix
        # SwiftVerifyEmittedModuleInterface failures on Xcode 16+
        if target.name == 'Kingfisher'
          config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'NO'
        end
      end
    end
  end
end
