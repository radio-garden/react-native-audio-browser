{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "stripInternal": true
  },
  "exclude": [
    "**/node_modules",
    "**/lib",
    "src/web/**",
    "**/*.web.ts",
    "**/.eslintrc.js",
    "**/.prettierrc.js",
    "**/babel.config.js",
    "**/metro.config.js",
    "**/tsconfig.json",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ]
}
