#!/bin/sh
#
# Formats staged files and re-stages them: oxfmt for JS/TS/JSON/Markdown,
# SwiftFormat for `ios/`, ktfmt for `android/`.
#
# This exists because the three format checks are required in CI but nothing
# runs them locally, so a commit can look fine and fail on something as small as
# `*x*` where oxfmt wants `_x_`. Formatting is the one check that can be fixed
# for you rather than reported at you, so this hook fixes and moves on.
#
# It never blocks a commit. Lint, types and tests are still CI's job — if you
# want them locally, run `yarn ci:lint && yarn types && yarn test`.
#
# Cost is paid per language, and only when you stage that language: oxfmt is
# ~0.7s, SwiftFormat is instant, ktfmt is ~4s behind a warm Gradle daemon. A
# commit touching no Kotlin never waits for Gradle.
#
# Install: `yarn hooks:install` (runs automatically after `yarn install`).
# Skip once: `git commit --no-verify`.

root=$(git rev-parse --show-toplevel) || exit 0
cd "$root" || exit 0

# Split on newlines only, so paths containing spaces survive the unquoted
# expansions below (POSIX sh has no arrays to pass them through instead).
IFS='
'

# ACMR: added, copied, modified, renamed. Deleted files have nothing to format.
staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0

# Files with unstaged changes as well — `git add -p`, or an edit after staging.
# Must be read BEFORE any formatter runs, or everything looks partial.
partial=$(git diff --name-only --diff-filter=ACMR)

matching() {
  for file in $staged; do
    # shellcheck disable=SC2254 # $1 is a case pattern, deliberately unquoted
    case "$file" in $1) [ -f "$file" ] && printf '%s\n' "$file" ;; esac
  done
}

# What each formatter rewrote is read back off the files themselves rather than
# parsed out of three different stdout formats — one of which reports "Finished
# in 4ms on 0 files" on the same stream as the paths.
hashes() {
  for file in $staged; do
    [ -f "$file" ] && printf '%s %s\n' "$(git hash-object "$file")" "$file"
  done
}

before=$(hashes)

# --- JS, TS, JSON, Markdown ---------------------------------------------------
# oxfmt skips paths it has no parser for, so the whole staged list can go in as
# is. The ignore paths are the pair `yarn ci:format` uses, so an explicitly named
# CHANGELOG.md is still left alone.
if command -v yarn >/dev/null 2>&1; then
  # shellcheck disable=SC2086 # $staged is a newline-separated path list
  yarn oxfmt --write --no-error-on-unmatched-pattern \
    --ignore-path .gitignore --ignore-path .oxfmtignore $staged >/dev/null 2>&1
else
  # Some GUI git clients start from a minimal environment. Staying silent would
  # hide that nothing was formatted.
  echo "pre-commit: yarn not on PATH, skipping oxfmt" >&2
fi

# --- Swift --------------------------------------------------------------------
swift_files=$(matching 'ios/*.swift')
if [ -n "$swift_files" ]; then
  # Pinned in CI because SwiftFormat's output shifts between releases: running an
  # unpinned version here would reformat files the pinned one considers correct,
  # turning an unrelated commit into a repo-wide diff. Read the pin from the
  # workflow so there is one place to bump it.
  pinned=$(sed -n 's/^ *SWIFTFORMAT_VERSION: *//p' .github/workflows/test.yml | head -1)
  if ! command -v swiftformat >/dev/null 2>&1; then
    echo "pre-commit: swiftformat not installed, skipping ${swift_files}" >&2
  elif [ "$(swiftformat --version 2>/dev/null)" != "$pinned" ]; then
    echo "pre-commit: swiftformat $(swiftformat --version) != pinned $pinned, skipping" >&2
    echo "            (a different version reformats files CI considers correct)" >&2
  else
    # shellcheck disable=SC2086 # newline-separated path list
    swiftformat $swift_files >/dev/null 2>&1
  fi
fi

# --- Kotlin -------------------------------------------------------------------
if [ -n "$(matching 'android/*.kt')" ]; then
  # ktfmt only runs through Gradle, and the plugin has no way to limit it to a
  # file list — this formats every Kotlin source in the module, so unstaged .kt
  # edits get formatted too. Only staged files are re-staged, so the commit is
  # unaffected either way.
  gradlew=apps/example-native/android/gradlew
  if [ -x "$gradlew" ]; then
    (cd apps/example-native/android && ./gradlew -q --build-cache \
      :react-native-audio-browser:ktfmtFormat >/dev/null 2>&1) ||
      echo "pre-commit: ktfmt failed (needs a JDK and \`yarn install\`), skipping" >&2
  else
    echo "pre-commit: $gradlew missing, skipping ktfmt" >&2
  fi
fi

# --- Re-stage -----------------------------------------------------------------
restaged=''
skipped=''
after=$(hashes)
for line in $after; do
  case "$before" in
    *"$line"*) continue ;; # unchanged
  esac
  file=${line#* }
  # Re-staging a partially staged file would sweep its unstaged edits into the
  # commit. It has been formatted — the working tree is correct now — but the
  # staging is left to you.
  if echo "$partial" | grep -Fxq "$file"; then
    skipped="$skipped $file"
  else
    git add -- "$file"
    restaged="$restaged $file"
  fi
done

[ -n "$restaged" ] && echo "pre-commit: formatted and re-staged:$restaged"
if [ -n "$skipped" ]; then
  echo "pre-commit: formatted, but NOT re-staged (partially staged):$skipped" >&2
  echo "            committing without them — 'git add' and amend to include." >&2
fi

exit 0
